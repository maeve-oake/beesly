LISTEN_ADDRESS=0.0.0.0
PORT=6971

# Required: your Home Assistant instance URL.
HA_URL=
HA_TOKEN=
# Use HA_TOKEN_FILE instead of HA_TOKEN to read a token from a file.
# HA_TOKEN_FILE=/path/to/ha-token
HA_ENTITIES='[]'
# Named touch views; use UI_VIEWS_FILE for a JSON file instead.
# Independent of HA_ENTITIES (main menu) and AMI_SLOTS (BLF).
UI_VIEWS_FILE=views.example.json

# Optional: configure AMI to enable the BLF bridge.
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_PASSWORD=
# Use AMI_PASSWORD_FILE instead of AMI_PASSWORD to read a password from a file.
# AMI_PASSWORD_FILE=/path/to/ami-password
AMI_SLOTS='{}'

LOG_LEVEL=Information
FRAMEWORK_LOG_LEVEL=Warning
ALLOWED_HOSTS=*
